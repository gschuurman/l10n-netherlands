<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--
    Make sure this file is added to .prettierignore to prevent validation errors
    caused by the additional whitespace in length limited values.
-->
<template id="auditfile_template">
<auditfile
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://www.auditfiles.nl/XAF/3.2"
        >
    <header>
        <fiscalYear><t
                        t-out="self.fiscalyear_name"
                        t-options='{"widget": "auditfile.string9"}'
                    /></fiscalYear>
        <startDate><t t-out="self.date_start" /></startDate>
        <endDate><t t-out="self.date_end" /></endDate>
        <curCode><t t-out="self.company_id.currency_id.name" /></curCode>
        <dateCreated><t t-out="self.date_generated.date().isoformat()" /></dateCreated>
        <softwareDesc>Odoo</softwareDesc>
        <softwareVersion><t
                        t-out="self.get_odoo_version()"
                        t-options='{"widget": "auditfile.string20"}'
                    /></softwareVersion>
    </header>
    <company>
        <companyIdent><t
                        t-out="self.company_id.partner_id._get_additional_identifier('NL_KVK')"
                        t-options='{"widget": "auditfile.string35"}'
                    /></companyIdent>
        <companyName><t
                        t-out="self.company_id.name"
                        t-options='{"widget": "auditfile.string999"}'
                    /></companyName>
        <taxRegistrationCountry><t
                        t-out="self.company_id.country_id.code"
                    /></taxRegistrationCountry>
        <taxRegIdent><t
                        t-out="self.company_id.vat"
                        t-options='{"widget": "auditfile.string30"}'
                    /></taxRegIdent>
        <streetAddress>
            <streetname><t
                            t-out="self.company_id.street"
                            t-options='{"widget": "auditfile.string999"}'
                        /></streetname>
            <number />
            <numberExtension />
            <property />
            <city><t
                            t-out="self.company_id.city"
                            t-options='{"widget": "auditfile.string50"}'
                        /></city>
            <postalCode><t
                            t-out="self.company_id.zip"
                            t-options='{"widget": "auditfile.string15"}'
                        /></postalCode>
            <region><t
                            t-out="self.company_id.state_id.name"
                            t-options='{"widget": "auditfile.string50"}'
                        /></region>
            <country t-if="self.company_id.country_id"><t
                            t-out="self.company_id.country_id.code"
                        /></country>
        </streetAddress>
        <!-- we might look at self.company_id.address_get(adr_pref)
             but that doesn't really seem worth the effort
        <postalAddress/> /-->
        <customersSuppliers>
            <customerSupplier t-foreach="self.get_partners()" t-as="p">
                <custSupID><t t-out="p.id" /></custSupID>
                <custSupName><t
                                t-out="p.name"
                                t-options='{"widget": "auditfile.string50"}'
                            /></custSupName>
                <contact t-if="p.is_company and p.child_ids"><t
                                t-out="p.child_ids[0].name"
                                t-options='{"widget": "auditfile.string50"}'
                            /></contact>
                <telephone><t
                                t-out="p.phone"
                                t-options='{"widget": "auditfile.string30"}'
                            /></telephone>
                <eMail><t t-out="p.email" /></eMail>
                <website><t t-out="p.website" /></website>
                <!-- not in standard data model
                <commerceNr /> /-->
                <taxRegistrationCountry t-if="p.country_id"><t
                                t-out="p.country_id.code"
                            /></taxRegistrationCountry>
                <taxRegIdent><t
                                t-out="p.vat"
                                t-options='{"widget": "auditfile.string30"}'
                            /></taxRegIdent>
                <custSupTp><t
                                t-out="'B' if p.customer_rank > 0 and p.supplier_rank > 0 else 'C' if p.customer_rank > 0 else 'S' if p.supplier_rank > 0 else 'O'"
                            /></custSupTp>
                <!-- those need to be defined in <basics/> and are not required
                     labels might be used here
                <relationshipID>String</relationshipID>
                <custSupGrpID>String</custSupGrpID> -->
                <custCreditLimit t-if="p.customer_rank > 0 and p.credit_limit"><t
                                t-out="p.credit_limit"
                            /></custCreditLimit>
                <supplierLimit t-if="p.supplier_rank > 0 and p.credit_limit"><t
                                t-out="p.credit_limit"
                            /></supplierLimit>
                <streetAddress>
                    <streetname><t
                                    t-out="p.street"
                                    t-options='{"widget": "auditfile.string999"}'
                                /></streetname>
                    <number />
                    <numberExtension />
                    <property />
                    <city><t
                                    t-out="p.city"
                                    t-options='{"widget": "auditfile.string50"}'
                                /></city>
                    <postalCode><t
                                    t-out="p.zip"
                                    t-options='{"widget": "auditfile.string10"}'
                                /></postalCode>
                    <region><t
                                    t-out="p.state_id.name"
                                    t-options='{"widget": "auditfile.string50"}'
                                /></region>
                    <country t-if="p.country_id"><t
                                    t-out="p.country_id.code"
                                /></country>
                </streetAddress>
                <bankAccount t-foreach="p.bank_ids" t-as="bank">
                    <bankAccNr><t t-out="bank.sanitized_acc_number" /></bankAccNr>
                    <bankIdCd><t t-out="bank.bank_bic or bank.bank_id.bic" /></bankIdCd>
                </bankAccount>
                <changeInfo t-if="p.write_uid">
                    <userID><t t-out="p.write_uid.id" /></userID>
                    <changeDateTime><t t-out="p.write_date.date().isoformat()" />T<t
                                    t-out="p.write_date.time().strftime('%H:%M:%S')"
                                /></changeDateTime>
                    <changeDescription>Last write</changeDescription>
                </changeInfo>
                <customerSupplierHistory />
            </customerSupplier>
        </customersSuppliers>
        <generalLedger>
            <ledgerAccount t-foreach="self.get_accounts()" t-as="a">
                <accID><t t-out="a.code" /></accID>
                <accDesc><t
                                t-out="a.name"
                                t-options='{"widget": "auditfile.string999"}'
                            /></accDesc>
                <accTp><t
                                t-out="'P' if a.internal_group in ['income', 'expense'] else 'B' if a.internal_group in ['asset', 'liability'] else 'M'"
                            /></accTp>
                <!-- don't export the following for now
                <leadCode>String</leadCode>
                <leadDescription>String</leadDescription>
                <leadReference>String</leadReference>
                <leadCrossRef>String</leadCrossRef>
                <taxonomy>
                    <taxoRef>String</taxoRef>
                    <entryPoint>
                        <entryPointRef>String</entryPointRef>
                        <conceptRef>String</conceptRef>
                        <domainMember>
                            <domainMemberRef>String</domainMemberRef>
                        </domainMember>
                    </entryPoint>
                </taxonomy>
                /-->
                <changeInfo t-if="a.write_uid">
                    <userID><t t-out="a.write_uid.id" /></userID>
                    <changeDateTime><t t-out="a.write_date.date().isoformat()" />T<t
                                    t-out="a.write_date.time().strftime('%H:%M:%S')"
                                /></changeDateTime>
                    <changeDescription>Last write</changeDescription>
                </changeInfo>
                <glAccountHistory />
            </ledgerAccount>
        </generalLedger>
        <vatCodes>
            <vatCode t-foreach="self.get_taxes()" t-as="t">
                <vatID><t t-out="t.id" /></vatID>
                <vatDesc><t
                                t-out="t.name"
                                t-options='{"widget": "auditfile.string999"}'
                            /></vatDesc>
<!--                <vatToPayAccID><t t-out="t.refund_account_id.code" /></vatToPayAccID>-->
<!--                <vatToClaimAccID><t t-out="t.account_id.code" /></vatToClaimAccID>-->
            </vatCode>
        </vatCodes>
        <periods>
            <period t-foreach="self.get_periods()" t-as="p">
                <periodNumber><t t-out="p.number" /></periodNumber>
                <periodDesc><t
                                t-out="p.name"
                                t-options='{"widget": "auditfile.string50"}'
                            /></periodDesc>
                <startDatePeriod><t t-out="p.date_start" /></startDatePeriod>
                <endDatePeriod><t t-out="p.date_end" /></endDatePeriod>
            </period>
        </periods>
        <openingBalance>
            <t t-set="ob_totals" t-value="self.get_ob_totals()" />
            <opBalDate><t t-out="self.date_start" /></opBalDate>
            <opBalDesc>Opening balance</opBalDesc>
            <linesCount><t t-out="ob_totals['count']" /></linesCount>
            <totalDebit><t t-out="round(ob_totals['debit'], 2)" /></totalDebit>
            <totalCredit><t t-out="round(ob_totals['credit'], 2)" /></totalCredit>
            <obLine t-foreach="self.get_ob_lines()" t-as="l">
                <nr><t t-out="l['account_id']" /></nr>
                <accID><t t-out="l['account_code']" /></accID>
                <amnt><t t-out="round(abs(l['balance']), 2)" /></amnt>
                <amntTp><t t-out="'C' if l['balance'] &lt; 0 else 'D'" /></amntTp>
            </obLine>
        </openingBalance>
        <transactions>
            <linesCount><t t-out="self.get_move_line_count()" /></linesCount>
            <totalDebit><t
                            t-out="round(self.get_move_line_total_debit(), 2)"
                        /></totalDebit>
            <totalCredit><t
                            t-out="round(self.get_move_line_total_credit(), 2)"
                        /></totalCredit>
            <journal t-foreach="self.get_journals()" t-as="j">
                <jrnID><t t-out="j.code" /></jrnID>
                <desc><t t-out="j.name" /></desc>
                <jrnTp><t
                                t-out="'B' if j.type == 'bank' else 'C' if j.type == 'cash' else 'O' if j.type == 'situation' else 'S' if j.type in ['sale', 'sale_refund'] else 'P' if j.type in ['purchase', 'purchase_refund'] else 'Z'"
                            /></jrnTp>
                <!-- thouse would probably be added by appropriate modules
                <offsetAccID />
                <bankAccNr />
                /-->
                <transaction t-foreach="self.get_moves(j)" t-as="m">
                    <nr><t t-out="m.id" /></nr>
                    <desc><t t-out="m.name" /></desc>
                    <periodNumber><t
                                    t-out="self.get_move_period_number(m)"
                                /></periodNumber>
                    <trDt><t t-out="m.date" /></trDt>
                    <amnt><t t-out="round(m.amount_total,2)" /></amnt>
                    <!-- left to inheriting modules
                    <sourceID />
                    <userID />
                    /-->
                    <trLine
                                t-foreach="m.line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))"
                                t-as="l"
                            >
                        <nr><t t-out="l.id" /></nr>
                        <accID><t t-out="l.account_id.code" /></accID>
                        <docRef><t
                                        t-out="l.ref and l.ref[:35] if self.unit4 == True else l.ref"
                                        t-options='{"widget": "auditfile.string999"}'
                                    /></docRef>
                        <effDate><t t-out="l.date" /></effDate>
                        <desc><t t-out="l.name" /></desc>
                        <amnt><t t-out="abs(round(l.balance,2))" /></amnt>
                        <amntTp><t t-out="'C' if l.credit else 'D'" /></amntTp>
                        <recRef t-if="l.full_reconcile_id"><t
                                        t-out="l.full_reconcile_id.id"
                                    /></recRef>
                        <custSupID t-if="l.partner_id"><t
                                        t-out="l.partner_id.id"
                                    /></custSupID>
                        <invRef t-if="m.is_invoice(include_receipts=True)"><t
                                        t-out="m.name"
                                        t-options='{"widget": "auditfile.string999"}'
                                    /></invRef>
                        <!-- future extensions
                        <matchKeyID />
                        <orderRef />
                        <receivingDocRef />
                        <shipDocRef />
                        <costID />
                        <prodID />
                        <projID />
                        <artGrpID />
                        <workCostArrRef />
                        <qntityID />
                        <qntity />
                        <bankAccNr />
                        <bankIdCd />
                        <vat />
                        /-->
                        <currency t-if="l.currency_id and l.amount_currency">
                            <curCode><t t-out="l.currency_id.name" /></curCode>
                            <curAmnt><t t-out="round(l.amount_currency,2)" /></curAmnt>
                        </currency>
                    </trLine>
                </transaction>
            </journal>
        </transactions>
    </company>
</auditfile>
</template>
</odoo>
